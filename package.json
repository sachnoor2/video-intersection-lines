{
  "name": "video-intersection-lines",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion explainer for RACE 04 question 4: ten lines in general position, join every intersection point, count the lines (answer 640)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "tts": "python3 scripts/tts.py",
